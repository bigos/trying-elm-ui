<div id="elm">Please wait...</div>
<% flag_data = {base_url: request.base_url, logname:  ENV['LOGNAME']} %>


<%= javascript_include_tag 'elm-cocktails' %>
<script>
 function loadElm() {
   var app = Elm.Cocktails.init({ node: document.getElementById('elm'),
                                  flags: <%= raw JSON.generate flag_data %>
   })
 }
 // you can use ports and stuff here
 document.addEventListener('DOMContentLoaded', loadElm)
</script>
